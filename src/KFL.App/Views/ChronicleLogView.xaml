<UserControl x:Class="KFL.App.Views.ChronicleLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 纪事（家族流水）：标题 + 清空按钮 + 自动滚到最新的列表。 -->
    <DockPanel Margin="6,4,6,6">
        <DockPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Right" Content="清空纪事" Padding="8,1"
                    Command="{Binding DoCommand}" CommandParameter="clearlog"
                    ToolTip="清空界面上的纪事列表（玩家反馈 15）；完全相同的行会合并为「× N」" />
            <TextBlock Text="纪事（家族流水）" Style="{StaticResource SectionHeader}" />
        </DockPanel>
        <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}" Style="{StaticResource LogList}" />
    </DockPanel>
</UserControl>
