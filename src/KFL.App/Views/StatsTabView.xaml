<UserControl x:Class="KFL.App.Views.StatsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KFL.App.Controls">
    <!-- 统计页：导出 CSV / 概览 / 图表口径切换 / 可滚动折线图卡片 / 局势速览。 -->
    <DockPanel Margin="6">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
            <Button Content="导出流水账 CSV" Command="{Binding DoCommand}" CommandParameter="export" />
            <TextBlock Text="折线图按月聚合自族流水账；每张图可左右滚动（默认滚到最新），鼠标悬停看当月数值及同比 / 环比。"
                       Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Border DockPanel.Dock="Top" Margin="0,0,0,6" Padding="8,6" Background="{StaticResource PanelBrush}"
                BorderBrush="#FFBFAE8E" BorderThickness="1" CornerRadius="3">
            <StackPanel>
                <TextBlock Text="概览（同比 / 环比）" Style="{StaticResource SectionHeader}" Margin="0,0,0,2" />
                <TextBlock Text="{Binding OverviewCaption}" Style="{StaticResource Secondary}" />
                <ItemsControl ItemsSource="{Binding OverviewCards}" Margin="0,6,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="162" Margin="0,0,6,6" Padding="7,5" Background="#FFFFFDF7"
                                    BorderBrush="#FFD8CBB2" BorderThickness="1" CornerRadius="2"
                                    ToolTip="同比 = 与去年同月相比；环比 = 与上月相比。基期为 0 或历史不足时显示「—」。">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Secondary}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                                        <TextBlock Text="{Binding Value}" FontSize="22" FontWeight="Bold" />
                                        <TextBlock Text="{Binding Unit}" Style="{StaticResource Secondary}"
                                                   VerticalAlignment="Bottom" Margin="3,0,0,3" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding YearOverYear}" FontSize="13" Foreground="#5A5A5A" />
                                    <TextBlock Text="{Binding MonthOverMonth}" FontSize="13" Foreground="#5A5A5A" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <TextBlock Text="收支图口径：" VerticalAlignment="Center" FontWeight="Bold" />
            <RadioButton Content="当月" GroupName="MoneyScale" IsChecked="{Binding IsMoneyChartMonthly, Mode=TwoWay}" Margin="4,0" />
            <RadioButton Content="累计" GroupName="MoneyScale" IsChecked="{Binding IsMoneyChartCumulative, Mode=TwoWay}" Margin="4,0" />
            <TextBlock Text="  人口图口径：" VerticalAlignment="Center" FontWeight="Bold" />
            <RadioButton Content="当月" GroupName="PopScale" IsChecked="{Binding IsPopulationChartMonthly, Mode=TwoWay}" Margin="4,0" />
            <RadioButton Content="累计" GroupName="PopScale" IsChecked="{Binding IsPopulationChartCumulative, Mode=TwoWay}" Margin="4,0" />
        </WrapPanel>

        <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,6" MinHeight="300" MaxHeight="470">
            <ItemsControl ItemsSource="{Binding Charts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:StatChartCard />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="局势速览（算好的数字）" Style="{StaticResource SectionHeader}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding StatsInsights}" Style="{StaticResource Monospace}" />
                    <TextBlock Text="{Binding StatisticsText}" Style="{StaticResource Monospace}" Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </DockPanel>
</UserControl>
