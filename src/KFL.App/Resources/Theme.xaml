<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:KFL.App">

    <!-- 转换器：布尔可见性 / 画刷键名按名取用 -->
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <local:BrushKeyConverter x:Key="BrushKey" />

    <!-- 一甲名次配色（规格书 §12.2：第 1 金 / 第 2 紫 / 第 3 蓝） -->
    <SolidColorBrush x:Key="PlacementGoldBrush" Color="#B8860B" />
    <SolidColorBrush x:Key="PlacementPurpleBrush" Color="#7B2D8B" />
    <SolidColorBrush x:Key="PlacementBlueBrush" Color="#1F5FA8" />
    <SolidColorBrush x:Key="PlacementInkBrush" Color="#2B2B2B" />

    <SolidColorBrush x:Key="PanelBrush" Color="#FFF8F0E3" />
    <SolidColorBrush x:Key="InkBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="AccentBrush" Color="#8B1A1A" />

    <!-- 关系按钮配色（规格书 §17 第九轮：按亲属状态换色以便区分） -->
    <SolidColorBrush x:Key="RelationBrush" Color="#1F5FA8" />
    <SolidColorBrush x:Key="RelationIllBrush" Color="#C0392B" />
    <SolidColorBrush x:Key="RelationSentenceBrush" Color="#5D4037" />
    <SolidColorBrush x:Key="RelationDeceasedBrush" Color="#8A8A8A" />
    <SolidColorBrush x:Key="RelationWarnBrush" Color="#B8860B" />

    <!-- 家主一脉嫡系男性的卡片样式（规格书 §17 第九轮） -->
    <SolidColorBrush x:Key="HeadHeirBrush" Color="#8B1A1A" />
    <SolidColorBrush x:Key="HeadHeirFill" Color="#FFF3D9" />

    <!-- 统计图配色（ChartBrush1..7 供 ChartSeries.BrushKey 按名取用） -->
    <SolidColorBrush x:Key="ChartBrush1" Color="#C0392B" />
    <SolidColorBrush x:Key="ChartBrush2" Color="#1F5FA8" />
    <SolidColorBrush x:Key="ChartBrush3" Color="#1E8449" />
    <SolidColorBrush x:Key="ChartBrush4" Color="#B8860B" />
    <SolidColorBrush x:Key="ChartBrush5" Color="#7B2D8B" />
    <SolidColorBrush x:Key="ChartBrush6" Color="#5D4037" />
    <SolidColorBrush x:Key="ChartBrush7" Color="#00838F" />

    <!-- 全局字号：玩家反馈「文字偏小」，整体上调一档 -->
    <Style TargetType="Button">
        <Setter Property="Margin" Value="0,0,5,5" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="FontSize" Value="16" />
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontSize" Value="16" />
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Margin" Value="0,0,4,4" />
        <Setter Property="Padding" Value="4,3" />
        <Setter Property="FontSize" Value="16" />
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Margin" Value="0,0,4,4" />
        <Setter Property="MinWidth" Value="130" />
        <Setter Property="FontSize" Value="16" />
    </Style>
    <Style TargetType="ListBox">
        <Setter Property="FontSize" Value="16" />
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Padding" Value="12,5" />
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="Margin" Value="0,7,0,3" />
        <Setter Property="FontSize" Value="17" />
    </Style>
    <Style x:Key="Secondary" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#5A5A5A" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- 大段等宽文本（成员详情 / 统计 / 编年史 / 收支明细）统一入口 -->
    <Style x:Key="Monospace" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontSize" Value="16" />
    </Style>
    <Style x:Key="MonospaceSmall" TargetType="TextBlock" BasedOn="{StaticResource Monospace}">
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- 纪事列表：等宽小字、不出现横向滚动条 -->
    <Style x:Key="LogList" TargetType="ListBox">
        <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
</ResourceDictionary>
