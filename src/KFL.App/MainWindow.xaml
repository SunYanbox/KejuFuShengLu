<Window x:Class="KFL.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:KFL.App.Views"
        Title="科举浮生录" Height="920" Width="1440"
        WindowStartupLocation="CenterScreen"
        Background="#FFFDF6E9"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="170" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FF8B1A1A" Padding="8,4">
                <TextBlock Text="{Binding StatusLine}" Foreground="White" FontWeight="Bold" />
            </Border>
            <Border Grid.Row="1" Background="#FFF3E6CF" Padding="8,3">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="本月收支明细" Padding="8,1"
                            Command="{Binding DoCommand}" CommandParameter="balance"
                            ToolTip="单击显示按人、按来源罗列的本月收支悬浮窗（需求 7）" />
                    <TextBlock Text="{Binding EconomyLine}" />
                </DockPanel>
            </Border>
            <Border Grid.Row="2" Background="#FFEADFC6" Padding="8,3">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding MonthlyBalanceText}" FontWeight="Bold" Foreground="#FF1F5C2E" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ExamInfo}" TextWrapping="Wrap"
                                   ToolTip="考试报名窗口与预估录取率；详细来源见「成员详情」" />
                        <TextBlock Text="{Binding AchievementSummary}" Margin="24,0,0,0" Foreground="#FF5A5A5A" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <TabControl Grid.Row="3" Margin="6,4,6,0">
                <TabItem Header="家族">
                    <views:FamilyTabView />
                </TabItem>
                <TabItem Header="统计">
                    <views:StatsTabView />
                </TabItem>
                <TabItem Header="成就">
                    <views:AchievementsTabView />
                </TabItem>
                <TabItem Header="存档与设置">
                    <views:SavesTabView />
                </TabItem>
            </TabControl>

            <views:ChronicleLogView Grid.Row="4" />

            <!-- 本月收支悬浮窗（需求 7）：按人、按来源罗列 -->
            <views:BalanceBreakdownView Grid.Row="0" Grid.RowSpan="5" />

            <!-- 考试录取率已合并进「成员详情」与控制台 examrates，不再单独开悬浮窗（玩家反馈 14） -->
        </Grid>

        <views:StartMenuView />
        <views:EndingView />
        <views:ConsoleOverlayView />
    </Grid>
</Window>
