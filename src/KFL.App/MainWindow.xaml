<Window x:Class="KFL.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="科举浮生录" Height="920" Width="1440"
        WindowStartupLocation="CenterScreen"
        Background="#FFFDF6E9"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="170" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FF8B1A1A" Padding="8,4">
                <TextBlock Text="{Binding StatusLine}" Foreground="White" FontWeight="Bold" />
            </Border>
            <Border Grid.Row="1" Background="#FFF3E6CF" Padding="8,3">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="本月收支明细" Padding="8,1"
                            Command="{Binding DoCommand}" CommandParameter="balance"
                            ToolTip="单击显示按人、按来源罗列的本月收支悬浮窗（需求 7）" />
                    <TextBlock Text="{Binding EconomyLine}" />
                </DockPanel>
            </Border>
            <Border Grid.Row="2" Background="#FFEADFC6" Padding="8,3">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding MonthlyBalanceText}" FontWeight="Bold" Foreground="#FF1F5C2E" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ExamInfo}" TextWrapping="Wrap"
                                   MouseLeftButtonUp="OnExamInfoMouseUp"
                                   ToolTip="双击显示本场考试的录取率来源与算式（需求 18）" />
                        <TextBlock Text="{Binding AchievementSummary}" Margin="24,0,0,0" Foreground="#FF5A5A5A" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TabControl Grid.Row="3" Margin="6,4,6,0">
                <TabItem Header="家族">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="380" />
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0" Margin="4">
                            <TextBlock DockPanel.Dock="Top" Text="成员（可筛选）" Style="{StaticResource SectionHeader}" />
                            <ComboBox DockPanel.Dock="Top" ItemsSource="{Binding MemberFilters}" DisplayMemberPath="Text"
                                      SelectedItem="{Binding SelectedMemberFilter, Mode=TwoWay}" />
                            <TextBlock DockPanel.Dock="Top" Text="{Binding MemberCountText}" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                            <TextBlock DockPanel.Dock="Bottom" Text="归档 = 亡故 / 外嫁" Style="{StaticResource Secondary}" />
                            <ListBox ItemsSource="{Binding Members}"
                                     SelectedItem="{Binding Selected, Mode=TwoWay}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#FFBFAE8E" BorderThickness="1" CornerRadius="3"
                                                Margin="2" Padding="6" Background="{StaticResource PanelBrush}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Caption}" FontWeight="Bold" FontSize="14"
                                                               Foreground="{Binding PlacementBrush}" />
                                                    <TextBlock Text="{Binding HeadMark}" Margin="6,0,0,0" Foreground="#FF8B1A1A" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding PlacementText}" Foreground="{Binding PlacementBrush}" />
                                                <TextBlock Text="{Binding DegreeText}" />
                                                <TextBlock Text="{Binding RankText}" />
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Secondary}" />
                                                <TextBlock Text="{Binding BadgeText}" Foreground="#FF8B1A1A" TextWrapping="Wrap"
                                                           FontSize="12" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <DockPanel Grid.Column="1" Margin="4">
                            <TextBlock DockPanel.Dock="Top" Text="成员详情（卡片点开）" Style="{StaticResource SectionHeader}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding DetailText}" FontFamily="Consolas, Microsoft YaHei" />
                            </ScrollViewer>
                        </DockPanel>

                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="4">
                            <StackPanel>
                                <TextBlock Text="时间" Style="{StaticResource SectionHeader}" />
                                <WrapPanel>
                                    <Button Content="下月" Command="{Binding DoCommand}" CommandParameter="advance" />
                                    <Button Content="快进一年" Command="{Binding DoCommand}" CommandParameter="ff:12" />
                                    <Button Content="快进三月" Command="{Binding DoCommand}" CommandParameter="ff:3" />
                                    <Button Content="快进到科举" Command="{Binding DoCommand}" CommandParameter="ffexam"
                                            ToolTip="直接推进到下一次科举报名窗口（要求 6）" />
                                    <Button Content="停止" Command="{Binding DoCommand}" CommandParameter="stop" />
                                </WrapPanel>
                                <TextBlock Text="{Binding AdvanceLabel}" Style="{StaticResource Secondary}" />

                                <TextBlock Text="科举与行贿" Style="{StaticResource SectionHeader}" />
                                <WrapPanel>
                                    <Button Content="报名" Command="{Binding DoCommand}" CommandParameter="exam" />
                                    <Button Content="受特奏名" Command="{Binding DoCommand}" CommandParameter="special" />
                                    <Button Content="贿解试" IsEnabled="{Binding CanBribe}" Command="{Binding DoCommand}" CommandParameter="bribe:JieShi" />
                                    <Button Content="贿省试" IsEnabled="{Binding CanBribe}" Command="{Binding DoCommand}" CommandParameter="bribe:ShengShi" />
                                    <Button Content="贿殿试" IsEnabled="{Binding CanBribe}" Command="{Binding DoCommand}" CommandParameter="bribe:DianShi" />
                                </WrapPanel>

                                <TextBlock Text="家计" Style="{StaticResource SectionHeader}" />
                                <WrapPanel>
                                    <Button Content="拮据" Command="{Binding DoCommand}" CommandParameter="living:Frugal" />
                                    <Button Content="普通" Command="{Binding DoCommand}" CommandParameter="living:Normal" />
                                    <Button Content="体面" Command="{Binding DoCommand}" CommandParameter="living:Comfortable" />
                                    <Button Content="持续报考开关" Command="{Binding DoCommand}" CommandParameter="autoexam" />
                                </WrapPanel>
                                <WrapPanel>
                                    <TextBlock Text="产业：" VerticalAlignment="Center" />
                                    <ComboBox ItemsSource="{Binding AssetKinds}" DisplayMemberPath="Text" SelectedItem="{Binding SelectedAssetKind}" />
                                </WrapPanel>
                                <WrapPanel>
                                    <Button Content="买 ×1" Command="{Binding DoCommand}" CommandParameter="assetbuy:1" />
                                    <Button Content="买 ×10" Command="{Binding DoCommand}" CommandParameter="assetbuy:10" />
                                    <Button Content="卖 ×1" Command="{Binding DoCommand}" CommandParameter="assetsell:1" />
                                    <Button Content="卖 ×10" Command="{Binding DoCommand}" CommandParameter="assetsell:10" />
                                </WrapPanel>
                                <WrapPanel>
                                    <Button Content="存 10 贯" Command="{Binding DoCommand}" CommandParameter="money:savings:10" />
                                    <Button Content="取 10 贯" Command="{Binding DoCommand}" CommandParameter="money:cash:10" />
                                    <Button Content="还贷 10 贯" Command="{Binding DoCommand}" CommandParameter="repay:10" />
                                </WrapPanel>
                                <WrapPanel>
                                    <Button Content="商本投入 10 贯" Command="{Binding DoCommand}" CommandParameter="merchant:in:10"
                                            ToolTip="从现银划入商本（经商收益按商本计，可随时抽回）" />
                                    <Button Content="商本抽回 10 贯" Command="{Binding DoCommand}" CommandParameter="merchant:out:10"
                                            ToolTip="从商本划回现银" />
                                </WrapPanel>

                                <TextBlock Text="婚育与人事" Style="{StaticResource SectionHeader}" />
                                <WrapPanel>
                                    <Button Content="托媒" Command="{Binding DoCommand}" CommandParameter="matchmake" />
                                    <Button Content="买功名婚姻" Command="{Binding DoCommand}" CommandParameter="matchmake:degree" />
                                    <Button Content="应允提亲" Command="{Binding DoCommand}" CommandParameter="proposal:accept" />
                                    <Button Content="买功名应允" Command="{Binding DoCommand}" CommandParameter="proposal:accept:degree" />
                                    <Button Content="婉拒提亲" Command="{Binding DoCommand}" CommandParameter="proposal:reject" />
                                    <Button Content="申请生育" Command="{Binding DoCommand}" CommandParameter="childbirth" />
                                    <Button Content="买人口" Command="{Binding DoCommand}" CommandParameter="buyperson" />
                                    <Button Content="就医" Command="{Binding DoCommand}" CommandParameter="treat" />
                                    <Button Content="名师开关" Command="{Binding DoCommand}" CommandParameter="tutor" />
                                    <Button Content="立为家主" Command="{Binding DoCommand}" CommandParameter="head" />
                                </WrapPanel>
                                <CheckBox Content="自动治疗（每月为患病成员开疗程）" IsChecked="{Binding AutoTreat, Mode=TwoWay}"
                                          Margin="0,4,0,0" ToolTip="要求 10" />

                                <TextBlock Text="存档" Style="{StaticResource SectionHeader}" />
                                <WrapPanel>
                                    <Button Content="存档" Command="{Binding DoCommand}" CommandParameter="save" />
                                    <Button Content="另存为" Command="{Binding DoCommand}" CommandParameter="saveas" />
                                    <Button Content="备份" Command="{Binding DoCommand}" CommandParameter="backup" />
                                    <Button Content="回主菜单" Command="{Binding DoCommand}" CommandParameter="menu" />
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem Header="统计">
                    <DockPanel Margin="6">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="导出流水账 CSV" Command="{Binding DoCommand}" CommandParameter="export" />
                            <TextBlock Text="三张折线图按月聚合自族流水账，纵向排列、左右对齐（同一画布宽度）；下方仍保留文字汇总。" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,6">
                            <ItemsControl ItemsSource="{Binding Charts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#FFBFAE8E" BorderThickness="1" CornerRadius="3"
                                                Margin="0,0,0,8" Padding="8" Background="{StaticResource PanelBrush}"
                                                HorizontalAlignment="Left">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Secondary}" Width="820" TextWrapping="Wrap" />
                                                <Canvas Width="{Binding Width}" Height="{Binding Height}" ClipToBounds="False">
                                                    <!-- 网格底：坐标轴 -->
                                                    <Line X1="0" Y1="0" X2="0" Y2="{Binding Height}" Stroke="#FFCFC3A8" />
                                                    <Line X1="0" Y1="{Binding Height}" X2="{Binding Width}" Y2="{Binding Height}" Stroke="#FFCFC3A8" />
                                                    <!-- 折线：每条系列一条 Polyline -->
                                                    <ItemsControl ItemsSource="{Binding Series}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <Canvas />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Polyline Points="{Binding Points}" Stroke="{Binding BrushKey, Converter={StaticResource BrushKey}}"
                                                                          StrokeThickness="2" Fill="Transparent" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <!-- Y 轴刻度 -->
                                                    <ItemsControl ItemsSource="{Binding YTicks}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <Canvas />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemContainerStyle>
                                                            <Style TargetType="ContentPresenter">
                                                                <Setter Property="Canvas.Left" Value="2" />
                                                                <Setter Property="Canvas.Top" Value="{Binding Position}" />
                                                            </Style>
                                                        </ItemsControl.ItemContainerStyle>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Text}" Margin="0,-9,0,0" FontSize="12" Foreground="#FF5A5A5A" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <!-- X 轴刻度 -->
                                                    <ItemsControl ItemsSource="{Binding XTicks}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <Canvas />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemContainerStyle>
                                                            <Style TargetType="ContentPresenter">
                                                                <Setter Property="Canvas.Left" Value="{Binding Position}" />
                                                                <Setter Property="Canvas.Top" Value="{Binding DataContext.XTickTop, RelativeSource={RelativeSource AncestorType=Canvas}}" />
                                                            </Style>
                                                        </ItemsControl.ItemContainerStyle>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Text}" FontSize="12" Foreground="#FF5A5A5A" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Canvas>
                                                <!-- 图例 -->
                                                <ItemsControl ItemsSource="{Binding Series}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,10,0">
                                                                <Rectangle Width="16" Height="4" VerticalAlignment="Center"
                                                                           Fill="{Binding BrushKey, Converter={StaticResource BrushKey}}" />
                                                                <TextBlock Text="{Binding Name}" Margin="4,0,0,0" FontSize="13" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding StatisticsText}" FontFamily="Consolas, Microsoft YaHei" />
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <TabItem Header="成就">
                    <DockPanel Margin="6">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock Text="成就一览" Style="{StaticResource SectionHeader}" />
                            <TextBlock Text="{Binding AchievementSummary}" />
                        </StackPanel>
                        <Grid DockPanel.Dock="Top" Margin="4,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="280" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="系列" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="编号" FontWeight="Bold" />
                            <TextBlock Grid.Column="2" Text="名称" FontWeight="Bold" />
                            <TextBlock Grid.Column="3" Text="状态" FontWeight="Bold" />
                            <TextBlock Grid.Column="4" Text="达成条件" FontWeight="Bold" />
                            <TextBlock Grid.Column="5" Text="达成于（难度 年/月 · 本机时刻）" FontWeight="Bold" />
                        </Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Achievements}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="280" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Series}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Code}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Name}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="3" Text="{Binding StateText}" />
                                            <TextBlock Grid.Column="4" Text="{Binding Description}" TextWrapping="Wrap" Foreground="#FF444444" />
                                            <TextBlock Grid.Column="5" Text="{Binding Detail}" FontSize="12" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>                    </DockPanel>
                </TabItem>

                <TabItem Header="存档与设置">
                    <Grid Margin="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="0,0,8,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0">
                                <TextBlock DockPanel.Dock="Top" Text="本机存档" Style="{StaticResource SectionHeader}" />
                                <Button DockPanel.Dock="Bottom" Content="读取选中存档"
                                        Command="{Binding DoCommand}" CommandParameter="load:selected" />
                                <ListBox ItemsSource="{Binding Saves}" DisplayMemberPath="Text"
                                         SelectedItem="{Binding SelectedSave, Mode=TwoWay}" />
                            </DockPanel>

                            <DockPanel Grid.Row="1" Margin="0,6,0,0">
                                <TextBlock DockPanel.Dock="Top" Text="备份存档（saves\backups，已压缩）" Style="{StaticResource SectionHeader}" />
                                <Button DockPanel.Dock="Bottom" Content="读取选中备份"
                                        Command="{Binding DoCommand}" CommandParameter="loadbackup" />
                                <ListBox ItemsSource="{Binding Backups}" DisplayMemberPath="Text"
                                         SelectedItem="{Binding SelectedBackup, Mode=TwoWay}" />
                            </DockPanel>
                        </Grid>

                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Text="选中存档概览" Style="{StaticResource SectionHeader}" />
                                <TextBlock Text="{Binding SaveOverviewText}" FontFamily="Consolas, Microsoft YaHei" />

                                <TextBlock Text="随时切换难度（次月生效）" Style="{StaticResource SectionHeader}" />
                                <WrapPanel>
                                    <Button Content="简单" Command="{Binding DoCommand}" CommandParameter="difficulty:Easy" />
                                    <Button Content="普通" Command="{Binding DoCommand}" CommandParameter="difficulty:Normal" />
                                    <Button Content="困难" Command="{Binding DoCommand}" CommandParameter="difficulty:Hard" />
                                    <Button Content="地狱" Command="{Binding DoCommand}" CommandParameter="difficulty:Hell" />
                                </WrapPanel>

                                <TextBlock Text="当前存档名（另存为用）" Style="{StaticResource SectionHeader}" />
                                <WrapPanel>
                                    <TextBox Text="{Binding SaveName, UpdateSourceTrigger=PropertyChanged}" Width="220" />
                                    <ComboBox ItemsSource="{Binding SaveFormats}" DisplayMemberPath="Text" SelectedItem="{Binding SelectedSaveFormat, Mode=TwoWay}" />
                                </WrapPanel>
                                <WrapPanel>
                                    <Button Content="另存为" Command="{Binding DoCommand}" CommandParameter="saveas" />
                                    <Button Content="改名（标识不变）" Command="{Binding DoCommand}" CommandParameter="rename" />
                                    <Button Content="立即备份" Command="{Binding DoCommand}" CommandParameter="backup" />
                                    <Button Content="返回主菜单" Command="{Binding DoCommand}" CommandParameter="menu" />
                                </WrapPanel>

                                <TextBlock Text="自动存档" Style="{StaticResource SectionHeader}" />
                                <TextBlock Text="每回合（月）结算后自动覆盖存档；每 3 回合写一次 saves/backups 备份；退出时自动保存。姓氏在开局时设定。" Style="{StaticResource Secondary}" />

                                <TextBlock Text="家族编年史" Style="{StaticResource SectionHeader}" />
                                <TextBlock Text="{Binding ChronicleText}" FontFamily="Consolas, Microsoft YaHei" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
            </TabControl>

            <DockPanel Grid.Row="4" Margin="6,4,6,6">
                <TextBlock DockPanel.Dock="Top" Text="纪事（家族流水）" Style="{StaticResource SectionHeader}" />
                <ListBox ItemsSource="{Binding LogLines}" FontFamily="Consolas, Microsoft YaHei" FontSize="12" />
            </DockPanel>

            <!-- 本月收支悬浮窗（需求 7）：按人、按来源罗列 -->
            <Border Grid.Row="0" Grid.RowSpan="5" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,96,40,0" MaxWidth="760" MaxHeight="620"
                    Background="#FFFDF6E9" BorderBrush="#FF8B1A1A" BorderThickness="2" CornerRadius="4" Padding="10"
                    Visibility="{Binding IsBreakdownVisible, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <Button DockPanel.Dock="Right" Content="关闭" Padding="8,1"
                                Command="{Binding DoCommand}" CommandParameter="balance" />
                        <TextBlock Text="本月收支明细（按人 / 按来源）" Style="{StaticResource SectionHeader}" />
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding MonthlyBreakdownText}" FontFamily="Consolas, Microsoft YaHei" FontSize="13" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 考试录取率明细悬浮窗（需求 18）：双击顶部考试条打开 -->
            <Border Grid.Row="0" Grid.RowSpan="5" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="40,96,0,0" MaxWidth="760" MaxHeight="620"
                    Background="#FFFDF6E9" BorderBrush="#FF1F5C2E" BorderThickness="2" CornerRadius="4" Padding="10"
                    Visibility="{Binding IsExamBreakdownVisible, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <Button DockPanel.Dock="Right" Content="关闭" Padding="8,1"
                                Command="{Binding DoCommand}" CommandParameter="examdetail" />
                        <TextBlock Text="录取率来源与算式（双击考试条开关）" Style="{StaticResource SectionHeader}" />
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding ExamBreakdownText}" FontFamily="Consolas, Microsoft YaHei" FontSize="13" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <Border Background="#FFFDF6E9" Visibility="{Binding IsMenuVisible, Converter={StaticResource BoolToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10">
            <StackPanel Width="560" VerticalAlignment="Top" HorizontalAlignment="Center">
                <TextBlock Text="科举浮生录" FontSize="34" FontWeight="Bold" Foreground="#FF8B1A1A" HorizontalAlignment="Center" />
                <TextBlock Text="一姓之兴衰，自此月始。" HorizontalAlignment="Center" Margin="0,4,0,16" />

                <TextBlock Text="出身" Style="{StaticResource SectionHeader}" />
                <ComboBox ItemsSource="{Binding Origins}" DisplayMemberPath="Text" SelectedItem="{Binding SelectedOrigin}" />

                <TextBlock Text="难度" Style="{StaticResource SectionHeader}" />
                <ComboBox ItemsSource="{Binding Difficulties}" DisplayMemberPath="Text" SelectedItem="{Binding SelectedDifficulty}" />

                <TextBlock Text="姓氏（可留空随机）" Style="{StaticResource SectionHeader}" />
                <TextBox Text="{Binding NewSurname, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="随机种子" Style="{StaticResource SectionHeader}" />
                <TextBox Text="{Binding NewSeed, UpdateSourceTrigger=PropertyChanged}" />

                <Button Content="开局" Command="{Binding StartGameCommand}" Margin="0,14,0,0" MinWidth="140" HorizontalAlignment="Center" />

                <TextBlock Text="读取已有存档" Style="{StaticResource SectionHeader}" Margin="0,14,0,0" />
                <ListBox ItemsSource="{Binding MenuSaves}" DisplayMemberPath="Text" Height="120"
                         SelectedItem="{Binding SelectedMenuSave, Mode=TwoWay}" />
                <Button Content="读取选中存档" Command="{Binding DoCommand}" CommandParameter="menuload"
                        Margin="0,6,0,0" HorizontalAlignment="Left" />
                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding MenuSaveOverviewText}" FontFamily="Consolas, Microsoft YaHei" TextWrapping="Wrap" />
                </ScrollViewer>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Background="#FFFDF6E9" Visibility="{Binding IsEnded, Converter={StaticResource BoolToVis}}">
            <StackPanel Width="760" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="家族绝嗣 · 结局" FontSize="28" FontWeight="Bold" Foreground="#FF8B1A1A" HorizontalAlignment="Center" />
                <ScrollViewer Height="430" Margin="0,12,0,12">
                    <TextBlock Text="{Binding ChronicleText}" FontFamily="Consolas, Microsoft YaHei" />
                </ScrollViewer>
                <WrapPanel HorizontalAlignment="Center">
                    <Button Content="读档" Command="{Binding DoCommand}" CommandParameter="load:selected" />
                    <Button Content="回主菜单" Command="{Binding DoCommand}" CommandParameter="menu" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="820" Height="{Binding ConsoleHeight}" Margin="12"
                Background="#F5201F1F" BorderBrush="#FFD8C48A" BorderThickness="2" CornerRadius="4"
                Visibility="{Binding ConsoleVisible, Converter={StaticResource BoolToVis}}">
            <DockPanel Margin="8">
                <TextBlock DockPanel.Dock="Top" Text="调试控制台（反引号 ` 开关）" Foreground="#FFECD9A0" FontWeight="Bold" />
                <WrapPanel DockPanel.Dock="Bottom">
                    <Button Content="唤醒 ×1" Command="{Binding ConsoleQuickCommand}" CommandParameter="wake 1" />
                    <Button Content="+100 贯" Command="{Binding ConsoleQuickCommand}" CommandParameter="money 100" />
                    <Button Content="治愈" Command="{Binding ConsoleQuickCommand}" CommandParameter="heal" />
                    <Button Content="病故" Command="{Binding ConsoleQuickCommand}" CommandParameter="kill" />
                    <Button Content="清行贿" Command="{Binding ConsoleQuickCommand}" CommandParameter="bribe-reset" />
                    <Button Content="释放" Command="{Binding ConsoleQuickCommand}" CommandParameter="release" />
                    <Button Content="免死" Command="{Binding ConsoleQuickCommand}" CommandParameter="pardon" />
                    <Button Content="解禁令" Command="{Binding ConsoleQuickCommand}" CommandParameter="clearbans" />
                    <Button Content="解全族禁令" Command="{Binding ConsoleQuickCommand}" CommandParameter="clearfamilybans" />
                    <Button Content="帮助" Command="{Binding ConsoleQuickCommand}" CommandParameter="help" />
                    <Button Content="隐藏" Command="{Binding DoCommand}" CommandParameter="console" />
                </WrapPanel>
                <TextBox DockPanel.Dock="Bottom" Text="{Binding ConsoleInput, UpdateSourceTrigger=PropertyChanged}"
                         Background="#FF101010" Foreground="#FFE8E8E8" FontFamily="Consolas">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ConsoleRunCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding ConsoleOutput}" Foreground="#FFD8D8D8" FontFamily="Consolas" TextWrapping="Wrap" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
